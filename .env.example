# ---- Database (Postgres) ----
# On Railway: add a Postgres plugin and Railway injects DATABASE_URL for you —
# you don't set it by hand there. For local development, either run a local
# Postgres and point this at it, or use the Railway database:
#   railway run npm run dev        # runs with Railway's env, incl. DATABASE_URL
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/gridiron?schema=public"

# ---- App ----
# The NFL season year the app is scored against (e.g. 2026 = the 2026-27 season).
NFL_SEASON="2026"

# Secret used to sign session cookies. Generate a long random string:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string"

# Optional: your league's display name (default: "The Pigskin Pickers").
LEAGUE_NAME="The Pigskin Pickers"

# Optional: hard deadline after which season picks can no longer change (ISO 8601).
# PICKS_DEADLINE="2026-09-10T20:20:00-04:00"
