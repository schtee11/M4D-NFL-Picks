# ---- Database ----
# Local dev (SQLite, zero setup):
DATABASE_URL="file:./dev.db"
#
# Production (Postgres) — set this on your host (Railway/Render/Fly/Supabase, etc.)
# and change prisma/schema.prisma `provider` to "postgresql".
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# ---- App ----
# The NFL season year the app is scored against (e.g. 2026 = the 2026-27 season).
NFL_SEASON="2026"

# Secret used to sign session cookies. Generate a long random string.
# e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string"
